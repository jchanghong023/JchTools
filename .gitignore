/target/
/dist/
/.cache/
/.vendor/
# 7-Zip 引擎下载产物（fetch-7zip.ps1 生成）：可执行文件与清单 MUST NOT 提交；
# 源码包、许可证目录与 NOTICE 同样只是本地构建材料，由打包脚本带入发布 ZIP。
/resources/7zip/7z.exe
/resources/7zip/7z.dll
/resources/7zip/7zz
/resources/7zip/manifest.json
/resources/7zip/License.txt
/resources/7zip/7z*-src.tar.xz
/resources/7zip/licenses/
/resources/7zip/NOTICE.txt
*.tmp
/.tmp/
# 性能打点日志（perf-tracing 特性）：运行时生成在用户状态目录的 perf-logs/ 下，不提交
perf-logs/
# Python 字节码缓存（运行 scripts/*.py 时生成在源码旁）
__pycache__/
