// 界面主题令牌：所有 UI 源文件共享的唯一 Design 全局（浅深主题由 Design.dark 切换）。
// 界面配色：所有颜色都是不透明色，浅色/深色主题由 Design.dark 决定（写入方见 AppWindow）。
// 视觉体系：冷中性工作台、品牌蓝、低对比结构线；卡片与输入区通过明度区分。
export global Design {
    in property <bool> dark: false;
    // 主色：品牌蓝 #2563EB（浅色）。Slint 1.17 的 Palette 颜色成员是 out 属性，应用层无法
    // 覆写；std 控件（ComboBox/TextEdit/Spinner）仍走 Fluent 蓝，自绘控件统一走这里的品牌蓝。
    in property <color> accent: dark ? #3570DB : #2563EB;
    in property <color> accent-hover: dark ? #316BD7 : #1D4ED8;
    in property <color> on-accent: #ffffff;
    in property <color> accent-ink: dark ? #AEC9FF : #1D4ED8;
    in property <color> brand-1: #3B7BFF;
    in property <color> brand-2: #1D4ED8;
    in property <color> danger: dark ? #F87171 : #dc2626;
    in property <color> danger-ink: dark ? #fca5a5 : #b91c1c;
    in property <color> warning: dark ? #fbbf24 : #d97706;
    in property <color> warning-ink: dark ? #fcd34d : #b45309;
    in property <color> success: dark ? #58D6A0 : #15803d;
    // 深色以冷灰区分工作区和面板；浅色以灰白区分，避免依赖阴影。
    in property <color> ink: dark ? #F0F3FA : #182235;
    in property <color> canvas: dark ? #11151D : #F4F6FA;
    in property <color> rail: dark ? #151A24 : #EDF1F7;
    in property <color> base: dark ? #1A202C : #ffffff;
    in property <brush> text: ink;
    in property <brush> text-muted: dark ? #B1BDCF : #526078;
    in property <color> muted-2: dark ? #8D9BB1 : #69788E;
    in property <brush> bar: accent;
    in property <color> card: base;
    // 内凹底色：分段控件底、进度轨等比卡片低一层。
    in property <color> sunken: dark ? #131923 : #EDF1F7;
    in property <color> inset: dark ? #131923 : #F5F7FB;
    in property <color> soft: dark ? #171D28 : #F8FAFD;
    in property <color> line: dark ? #2A3445 : #DFE5EF;
    in property <color> line-strong: dark ? #3D4B61 : #C6D0DF;
    in property <color> line-soft: dark ? #242D3C : #EBEFF5;
    in property <color> hover: dark ? #232D3E : #E2E9F4;
    in property <color> press: dark ? #2D3B52 : #D6E1F1;
    in property <color> accent-soft: dark ? #243B60 : #E3EDFF;
    in property <color> accent-softer: dark ? #1B2B43 : #F0F5FF;
    // 提示条底色：显式给出浅深两套，保证两主题都可读。
    in property <color> info-bg: dark ? #23304a : #eef3ff;
    in property <color> info-line: dark ? #31456e : #c7d8fe;
    in property <color> danger-bg: dark ? #3a2226 : #fef2f2;
    in property <color> danger-line: dark ? #5a2c31 : #fecaca;
    in property <color> warning-bg: dark ? #39301e : #fef3e2;
    in property <color> warning-line: dark ? #55482a : #f8deb8;
    // 规则说明的完整提示框：浅色主题用深色气泡、深色主题用浅色气泡，两套都保持反相差。
    in property <color> tip-bg: dark ? #343a42 : #1f2430;
    in property <color> tip-ink: dark ? #eef1f8 : #f6f7fb;
    in property <color> tip-line: dark ? #ffffff45 : #ffffff30;
    in property <color> shadow: dark ? #00000066 : #1018280d;
    in property <color> shadow-pop: dark ? #00000080 : #10182824;
    in property <color> scrim: dark ? #0000008c : #0f172a66;
    // 控件细节色
    in property <color> check-line: dark ? #65758F : #8B9BB1;
    in property <color> disabled-bg: dark ? #293243 : #E6EBF3;
    in property <color> close-hover: #e81123;
    in property <color> kbd-bg: dark ? #262a31 : #f4f5f7;
    // 分段控件（Pill）选中项的浮起底色：浅色用白卡，深色用比内凹底亮一档的中性色。
    // 深色主题下若沿用卡片底色（比 inset 更暗），选中项看起来像被按下而不是浮起。
    in property <color> pill-active: dark ? #343b47 : #ffffff;
}
