import { Button, CheckBox, ComboBox, LineEdit, ListView, TextEdit, Spinner, AboutSlint, Palette } from "std-widgets.slint";

export struct RuleRow { key: string, title: string, hint: string, kind: int, checked: bool, index: int, options: [string], value: string }
export struct PlanRow { id: string, selected: bool, kind: string, source: string, target: string, reason: string, state: string }
export struct ToolRow { id: string, name: string, summary: string }

// 界面配色：所有颜色都是不透明色，浅色/深色主题由 Design.dark 决定（写入方见 AppWindow）。
global Design {
    in property <bool> dark: false;
    in property <color> accent: #4f46e5;
    in property <color> accent-2: #0ea5e9;
    in property <color> accent-ink: dark ? #c7d2fe : #3730a3;
    in property <color> danger: #dc2626;
    in property <color> danger-ink: dark ? #fca5a5 : #b91c1c;
    in property <color> base: dark ? #1b1f2a : #ffffff;
    in property <color> ink: dark ? #eef1f8 : #16192a;
    in property <color> page-top: dark ? #232a3d : #eef0fd;
    in property <color> page-bottom: dark ? #172430 : #eaf6fc;
    in property <brush> text: ink;
    in property <brush> text-muted: ink.transparentize(0.15);
    in property <brush> page: @linear-gradient(150deg, page-top 0%, base 46%, page-bottom 100%);
    in property <brush> rail: @linear-gradient(180deg, base.mix(accent, 0.88) 0%, base.mix(accent-2, 0.94) 100%);
    in property <brush> bar: @linear-gradient(90deg, accent 0%, accent-2 100%);
    in property <color> card: base;
    in property <color> line: dark ? #ffffff24 : #10182824;
    in property <color> line-soft: dark ? #ffffff17 : #10182814;
    in property <color> hover: dark ? #ffffff1a : #10182812;
    in property <color> accent-soft: base.mix(accent, 0.84);
    in property <color> accent-softer: base.mix(accent, 0.93);
    in property <color> shadow: #0f172a26;
}

component Label inherits Text { color: Design.text; font-size: 14px; }
component Muted inherits Text { color: Design.text-muted; font-size: 12px; wrap: word-wrap; }

component Surface inherits Rectangle {
    background: Design.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Design.line;
    drop-shadow-color: Design.shadow;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 5px;
}

component LogoBadge inherits Rectangle {
    width: 36px; height: 36px; border-radius: 11px;
    background: Design.bar;
    drop-shadow-color: Design.accent.transparentize(0.55);
    drop-shadow-blur: 12px; drop-shadow-offset-y: 3px;
    Text { text: "M"; color: white; font-size: 19px; font-weight: 700;
        width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; }
}

// 侧栏导航的小图标：几何图形绘制，不依赖字体或图片资源
component NavGlyph inherits Rectangle {
    in property <int> kind: 0;          // 0 目录，1 记录，2 设置，3 关于
    in property <brush> tint: Design.text;
    width: 16px; height: 16px;
    background: transparent;

    if kind == 0: Rectangle {           // 文件夹
        x: 0; y: 4px; width: 16px; height: 11px; border-radius: 2px;
        background: transparent; border-width: 1.5px; border-color: root.tint;
    }
    if kind == 0: Rectangle { x: 1px; y: 1px; width: 7px; height: 4px; border-radius: 1px; background: root.tint; }
    if kind == 1: Rectangle { x: 0; y: 3px; width: 16px; height: 1.5px; border-radius: 1px; background: root.tint; }
    if kind == 1: Rectangle { x: 0; y: 7.25px; width: 16px; height: 1.5px; border-radius: 1px; background: root.tint; }
    if kind == 1: Rectangle { x: 0; y: 11.5px; width: 11px; height: 1.5px; border-radius: 1px; background: root.tint; }
    if kind == 2: Rectangle { x: 0; y: 3px; width: 16px; height: 1.5px; border-radius: 1px; background: root.tint; }
    if kind == 2: Rectangle { x: 0; y: 11.5px; width: 16px; height: 1.5px; border-radius: 1px; background: root.tint; }
    if kind == 2: Rectangle { x: 4px; y: 0.5px; width: 5px; height: 6.5px; border-radius: 2px; border-width: 1.5px; border-color: root.tint; background: transparent; }
    if kind == 2: Rectangle { x: 9px; y: 9px; width: 5px; height: 6.5px; border-radius: 2px; border-width: 1.5px; border-color: root.tint; background: transparent; }
    if kind == 3: Rectangle {
        width: 16px; height: 16px; border-radius: 8px;
        background: transparent; border-width: 1.5px; border-color: root.tint;
    }
    if kind == 3: Rectangle { x: 7.25px; y: 4px; width: 1.5px; height: 1.5px; border-radius: 1px; background: root.tint; }
    if kind == 3: Rectangle { x: 7.25px; y: 7px; width: 1.5px; height: 5px; border-radius: 1px; background: root.tint; }
}

// 侧栏与顶部导航项：整行可点，选中项带主色底和左侧色条
component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <int> icon: -1;
    callback clicked();
    height: 38px; border-radius: 10px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    background: !root.enabled ? transparent : root.active ? Design.accent-soft
        : (touch.has-hover ? Design.hover : transparent);

    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.active: Rectangle {
        x: 0; y: (root.height - 20px) / 2; width: 3px; height: 20px; border-radius: 2px;
        background: Design.accent;
    }
    if root.icon >= 0: NavGlyph {
        x: 13px; y: (root.height - 16px) / 2; kind: root.icon;
        tint: !root.enabled ? Design.text-muted : (root.active ? Design.accent-ink : Design.text-muted);
    }
    Text {
        x: root.icon >= 0 ? 37px : 13px; width: root.width - (root.icon >= 0 ? 46px : 22px); height: root.height;
        text: root.text; font-size: 14px; vertical-alignment: center; overflow: elide;
        color: !root.enabled ? Design.text-muted : (root.active ? Design.accent-ink : Design.text);
        font-weight: root.active ? 600 : 400;
    }
}

// 分段式标签（规则分区、面板切换）
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px; border-radius: 9px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    background: !root.enabled ? transparent : root.active ? Design.accent : (touch.has-hover ? Design.hover : Design.accent-softer);
    border-width: root.active ? 0px : 1px;
    border-color: Design.line-soft;

    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
        width: root.width; height: root.height; overflow: elide;
        color: !root.enabled ? Design.text-muted : (root.active ? white : Design.text);
        font-weight: root.active ? 600 : 400;
    }
}

// 面板切换用下划线标签（与分区的实心胶囊区分开，两者不同色不同形）
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px; border-radius: 8px;
    background: root.enabled && touch.has-hover && !root.active ? Design.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        x: 10px; width: root.width - 20px; height: root.height; text: root.text; font-size: 14px;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        color: !root.enabled ? Design.text-muted : (root.active ? Design.accent-ink : Design.text);
        font-weight: root.active ? 600 : 400;
    }
    if root.active: Rectangle {
        x: 8px; y: root.height - 3px; width: root.width - 16px; height: 2px; border-radius: 1px;
        background: Design.bar;
    }
}

// 进度条：已知总量用渐变填充，未知总量（扫描/哈希）用往返扫动的光带
component ProgressBar inherits Rectangle {
    in property <float> progress: -1;
    height: 8px; border-radius: 4px;
    background: Design.line-soft;
    clip: true;
    property <bool> sweep: false;
    property <length> bar-width: root.progress >= 0 ? max(4px, root.width * min(root.progress, 1.0)) : root.width / 4;
    Timer { interval: 850ms; running: root.progress < 0; triggered => { root.sweep = !root.sweep; } }
    Rectangle {
        width: root.bar-width; height: parent.height; border-radius: 4px;
        background: Design.bar;
        x: root.progress >= 0 ? 0px : (root.sweep ? root.width - self.width : 0px);
        animate x { duration: 850ms; easing: ease-in-out; }
    }
}

// 自绘窗口按钮：最小化、最大化/还原、关闭
component CaptionButton inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> maximized: false;
    callback activated();
    width: 46px; height: 32px;
    accessible-role: button;
    accessible-label: kind == 0 ? "最小化" : kind == 1 ? (maximized ? "还原" : "最大化") : "关闭";
    accessible-action-default => { root.activated(); }
    property <brush> glyph-color: touch.has-hover && kind == 2 ? white : Design.text;
    background: touch.has-hover ? (kind == 2 ? Design.danger : Design.hover) : transparent;

    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }

    if kind == 0: Rectangle {
        width: 10px; height: 1px; background: root.glyph-color;
        x: (root.width - 10px) / 2; y: (root.height - 1px) / 2;
    }
    if kind == 1 && !maximized: Rectangle {
        width: 10px; height: 10px; background: transparent;
        border-width: 1px; border-color: root.glyph-color;
        x: (root.width - 10px) / 2; y: (root.height - 10px) / 2;
    }
    if kind == 1 && maximized: Rectangle {
        width: 9px; height: 9px; background: transparent;
        border-width: 1px; border-color: root.glyph-color;
        x: (root.width - 9px) / 2 - 2px; y: (root.height - 9px) / 2 + 2px;
    }
    if kind == 1 && maximized: Rectangle {
        width: 9px; height: 9px; background: Design.card;
        border-width: 1px; border-color: root.glyph-color;
        x: (root.width - 9px) / 2 + 1px; y: (root.height - 9px) / 2 - 1px;
    }
    if kind == 2: Path {
        width: 10px; height: 10px;
        x: (root.width - 10px) / 2; y: (root.height - 10px) / 2;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.glyph-color; stroke-width: 1px;
    }
}

export component AppWindow inherits Window {
    title: "JchTools";
    icon: @image-url("../resources/app-icon.png");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1120px; preferred-height: 720px;
    min-width: 960px; min-height: 620px;
    background: Design.page;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    in-out property <string> directory;
    in-out property <int> screen: 0;
    in-out property <int> panel: 0;
    in-out property <int> section: 0;
    in-out property <bool> busy: false;
    in-out property <bool> ready: false;
    in-out property <bool> paused: false;
    in-out property <bool> has-task: false;
    in-out property <string> status: "请选择需要整理的目录";
    in-out property <string> metrics: "尚未扫描 · 不预估尚未解压文件的重复数量";
    in-out property <string> summary;
    in-out property <string> log-text;
    in-out property <string> error-text;
    in-out property <string> plan-page-label: "未生成计划";
    in-out property <int> theme: 0;
    in-out property <[RuleRow]> rules;
    in-out property <[PlanRow]> plans;
    in-out property <[ToolRow]> tools;
    in-out property <int> tool-count: 1;
    in-out property <[string]> history-items;
    in-out property <string> tool-search;
    in-out property <int> confirm-kind: 0;
    in-out property <string> confirm-text;
    in-out property <bool> acknowledge: false;
    in-out property <bool> conflict-visible: false;
    in-out property <string> conflict-text;
    in-out property <int> conflict-choice: 4;
    in-out property <bool> conflict-all: false;
    in-out property <bool> close-pending: false;
    in-out property <bool> system-dark: false;
    in-out property <float> progress: -1;
    in-out property <string> progress-note;

    callback choose-directory();
    callback root-edited();
    callback select-tool(string);
    callback search-tools(string);
    callback navigation(int);
    callback select-section(int);
    callback rule-bool(string,bool);
    callback rule-choice(string,int);
    callback rule-text(string,string);
    callback request-start();
    callback request-apply();
    callback confirmed(int);
    callback pause-task();
    callback cancel-task();
    callback plan-toggle(string,bool);
    callback plan-page(int);
    callback open-report();
    callback export-report();
    callback load-history(int);
    callback presets(int);
    callback answer-conflict(int,bool);
    callback window-drag-start(length,length);
    callback window-drag-move(length,length);
    property <length> caption-area: 138px;
    property <length> rail-width: 198px;
    property <length> page-padding: 22px;

    // 主题：0 跟随系统，1 浅色，2 深色；自绘配色与控件配色保持一致
    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Design.dark = root.theme == 2 || (root.theme == 0 && root.system-dark);
    }
    init => { root.apply-theme(); }
    changed theme => { root.apply-theme(); }
    changed system-dark => { root.apply-theme(); }

    // 背景装饰：柔和光晕铺在内容之下
    Rectangle {
        x: -140px; y: -180px; width: 620px; height: 620px;
        background: @radial-gradient(circle, Design.base.mix(Design.accent, 0.84) 0%, Design.base 72%);
    }
    Rectangle {
        x: parent.width - 460px; y: parent.height - 420px; width: 640px; height: 640px;
        background: @radial-gradient(circle, Design.base.mix(Design.accent-2, 0.86) 0%, Design.base 70%);
    }

    // 无系统标题栏：顶部条带负责拖动与窗口按钮，其余内容与普通窗口一致
    TouchArea {
        x: 0; y: 0; width: parent.width; height: 32px;
        double-clicked => { root.maximized = !root.maximized; }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.window-drag-start(self.mouse-x, self.mouse-y); }
        }
        moved => { root.window-drag-move(self.mouse-x, self.mouse-y); }
    }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.rail-width; background: Design.rail;
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Design.line; }
            VerticalLayout {
                padding: 18px; spacing: 10px;
                Rectangle { height: 8px; background: transparent; }
                HorizontalLayout { spacing: 11px; cross-axis-alignment: center;
                    LogoBadge { }
                    VerticalLayout { spacing: 2px;
                        Text { text: "JchTools"; color: Design.text; font-size: 19px; font-weight: 700; }
                        Muted { text: "本地工具箱"; }
                    }
                }
                if root.tool-count > 5: LineEdit {
                    text <=> root.tool-search; placeholder-text: "搜索工具";
                    edited(value) => { root.search-tools(value); }
                }
                Muted { text: "工具"; }
                for tool in root.tools: NavItem { text: tool.name; icon: 0; active: root.screen == 0;
                    clicked => { root.select-tool(tool.id); } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                NavItem { text: "任务记录"; icon: 1; active: root.screen == 1; clicked => { root.navigation(1); } }
                NavItem { text: "设置与规则预设"; icon: 2; active: root.screen == 2; clicked => { root.navigation(2); } }
                NavItem { text: "关于"; icon: 3; active: root.screen == 3; clicked => { root.navigation(3); } }
                Rectangle { height: 6px; background: transparent; }
                Muted { text: "本地处理 · 不上传文件\nWindows 优先"; }
            }
        }
        VerticalLayout {
            padding: root.page-padding; padding-top: 28px; spacing: 8px;
            HorizontalLayout { height: 30px; spacing: 10px; cross-axis-alignment: center;
                Label { text: root.screen == 0 ? "目录整理" : root.screen == 1 ? "任务记录" : root.screen == 2 ? "设置与规则预设" : "关于 JchTools";
                    font-size: 20px; font-weight: 700; }
                Rectangle { width: 3px; height: 16px; border-radius: 2px; background: Design.bar; }
                Muted { text: root.screen == 0 ? "递归解压、内容去重、冲突处理、归类与清理。每项操作都由你决定。" : "只显示真实可用的功能，不预留空分类。";
                    horizontal-stretch: 1; wrap: no-wrap; overflow: elide; vertical-alignment: center; }
                if root.busy: Spinner { width: 20px; height: 20px; }
                Rectangle { width: root.caption-area; background: transparent; }
            }
            if root.error-text != "": Rectangle {
                min-height: 38px; border-radius: 10px;
                background: Design.base.mix(Design.danger, 0.90);
                border-width: 1px; border-color: Design.base.mix(Design.danger, 0.62);
                HorizontalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 12px; padding-right: 12px; spacing: 10px; cross-axis-alignment: center;
                    Rectangle { width: 4px; height: 18px; border-radius: 2px; background: Design.danger; }
                    Text { text: root.error-text; wrap: word-wrap; color: Design.danger-ink; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "关闭"; clicked => { root.error-text = ""; } }
                }
            }
            if root.screen == 0: VerticalLayout {
                spacing: 8px;
                HorizontalLayout { height: 30px; spacing: 8px;
                    LineEdit { text <=> root.directory; placeholder-text: "选择或输入要整理的目录，例如 D:\\Downloads";
                        enabled: !root.busy; horizontal-stretch: 1; edited(value) => { root.root-edited(); } }
                    Button { text: "选择目录…"; enabled: !root.busy; clicked => { root.choose-directory(); } }
                }
                HorizontalLayout { height: 30px; spacing: 4px;
                    Tab { text: "处理规则"; active: root.panel == 0; width: 96px; clicked => { root.panel = 0; } }
                    Tab { text: "整理计划"; active: root.panel == 1; width: 96px; enabled: root.has-task; clicked => { root.panel = 1; } }
                    Tab { text: "进度与日志"; active: root.panel == 2; width: 106px; clicked => { root.panel = 2; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if root.has-task: Button { text: "打开任务目录"; enabled: !root.busy; clicked => { root.open-report(); } }
                    if root.has-task: Button { text: "导出报告"; enabled: !root.busy; clicked => { root.export-report(); } }
                    if root.busy: Button { text: root.paused ? "继续" : "暂停"; clicked => { root.pause-task(); } }
                    if root.busy: Button { text: "取消任务"; clicked => { root.cancel-task(); } }
                }
                if root.panel == 0: HorizontalLayout { height: 26px; spacing: 5px;
                    for label[index] in ["解压", "去重", "冲突", "归类", "清理", "安全与性能"]: Pill {
                        text: label; active: root.section == index; enabled: !root.busy; horizontal-stretch: 1;
                        clicked => { root.select-section(index); }
                    }
                }
                if root.panel == 0: Surface { vertical-stretch: 1;
                    ListView { for row in root.rules: Rectangle {
                        height: 50px;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 10px; cross-axis-alignment: center;
                            VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                Label { text: row.title; font-weight: 600; overflow: elide; }
                                Muted { text: row.hint; wrap: no-wrap; overflow: elide; }
                            }
                            if row.kind == 0: CheckBox { checked: row.checked; enabled: !root.busy;
                                text: "启用"; toggled => { root.rule-bool(row.key,self.checked); } }
                            if row.kind == 1: ComboBox { width: 190px; model: row.options; current-index: row.index;
                                enabled: !root.busy; selected(value) => { root.rule-choice(row.key,self.current-index); } }
                            if row.kind == 2: LineEdit { width: 130px; text: row.value; enabled: !root.busy;
                                horizontal-alignment: right; edited(value) => { root.rule-text(row.key,value); } }
                        }
                        Rectangle { y: parent.height - 1px; x: 12px; height: 1px; width: parent.width - 24px;
                            background: Design.line-soft; }
                    }}
                }
                if root.panel == 1: VerticalLayout { spacing: 8px;
                    Surface { height: 66px; TextEdit { text: root.summary; read-only: true; } }
                    Surface { vertical-stretch: 1;
                        ListView { for item in root.plans: Rectangle { height: 74px;
                            HorizontalLayout { padding: 8px; spacing: 10px;
                                CheckBox { checked: item.selected; enabled: root.ready && !root.busy;
                                    toggled => { root.plan-toggle(item.id,self.checked); } }
                                VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                    Label { text: item.kind + "  ·  " + item.state; font-weight: 600; color: Design.accent-ink; }
                                    Label { text: item.source; overflow: elide; }
                                    Muted { text: item.target == "" ? item.reason : "→ " + item.target + "\n" + item.reason; overflow: elide; }
                                }
                            }
                        }}
                    }
                    HorizontalLayout { height: 28px; spacing: 8px;
                        Button { text: "上一页"; enabled: !root.busy; clicked => { root.plan-page(-1); } }
                        Muted { text: root.plan-page-label; wrap: no-wrap; horizontal-alignment: center; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: "下一页"; enabled: !root.busy; clicked => { root.plan-page(1); } }
                    }
                }
                if root.panel == 2: Surface { vertical-stretch: 1;
                    VerticalLayout { padding: 10px; spacing: 6px;
                        Muted { text: "界面只保留最近 300 条消息；完整逐文件记录保存在本机任务数据库中，可导出。"; }
                        TextEdit { text: root.log-text; read-only: true; font-family: "Consolas"; vertical-stretch: 1; }
                    }
                }
                Surface { min-height: 48px;
                    background: @linear-gradient(120deg, Design.base.mix(Design.accent, 0.90) 0%, Design.base.mix(Design.accent-2, 0.94) 100%);
                    border-color: Design.base.mix(Design.accent, 0.70);
                    VerticalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 12px; padding-right: 12px; spacing: 6px;
                        HorizontalLayout { spacing: 10px; cross-axis-alignment: center;
                            VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                    Rectangle { width: 40px; height: 18px; border-radius: 5px;
                                        background: root.busy ? Design.accent : Design.accent-soft;
                                        Text { text: root.busy ? "进行中" : "状态"; font-size: 11px; font-weight: 600;
                                            color: root.busy ? white : Design.accent-ink;
                                            width: parent.width; height: parent.height;
                                            horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Label { text: root.status; overflow: elide; font-weight: 600; horizontal-stretch: 1; }
                                }
                                Muted { text: root.metrics; wrap: no-wrap; overflow: elide; }
                            }
                            if root.busy: Text { text: root.progress-note; wrap: no-wrap; overflow: elide; color: Design.accent-ink; font-weight: 600; }
                            if root.busy && root.progress >= 0: Text {
                                text: round(root.progress * 100) + "%"; font-size: 20px; font-weight: 700; color: Design.accent-ink;
                            }
                            if root.busy: Button { text: root.paused ? "继续" : "暂停"; clicked => { root.pause-task(); } }
                            if root.busy: Button { text: "取消任务"; clicked => { root.cancel-task(); } }
                            if !root.busy && root.ready: Button { text: "确认并执行整理"; primary: true; clicked => { root.request-apply(); } }
                            if !root.busy && !root.ready: Button { text: "开始解压与分析"; primary: true; enabled: root.directory != "";
                                clicked => { root.request-start(); } }
                        }
                        if root.busy: ProgressBar { progress: root.progress; }
                    }
                }
            }
            if root.screen == 1: VerticalLayout { spacing: 12px;
                Muted { text: "这里只展示真实任务；记录不会自动重放。中断任务需要重新扫描，不提供自建回滚或备份系统。"; }
                Surface { vertical-stretch: 1;
                    ListView { for item[index] in root.history-items: NavItem {
                        text: item; height: 46px; clicked => { root.load-history(index); }
                    }}
                }
                HorizontalLayout {
                    Button { text: "刷新记录"; clicked => { root.navigation(1); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
            }
            if root.screen == 2: VerticalLayout { spacing: 12px;
                Muted { text: "规则可以导出给其他机器使用；这里的保存只修改本机配置，不处理目录文件。"; }
                Surface { vertical-stretch: 1;
                    ListView { for row in root.rules: Rectangle { height: 86px;
                        HorizontalLayout { padding: 14px; spacing: 10px;
                            VerticalLayout { horizontal-stretch: 1; Label { text: row.title; font-weight: 600; } Muted { text: row.hint; } }
                            ComboBox { width: 220px; model: row.options; current-index: row.index;
                                selected(value) => { root.rule-choice(row.key,self.current-index); } }
                        }
                        Rectangle { y: parent.height - 1px; x: 14px; height: 1px; width: parent.width - 28px; background: Design.line-soft; }
                    }}
                }
                HorizontalLayout { spacing: 10px;
                    Button { text: "保存为默认规则"; enabled: !root.busy; clicked => { root.presets(0); } }
                    Button { text: "导出规则…"; enabled: !root.busy; clicked => { root.presets(1); } }
                    Button { text: "导入规则…"; enabled: !root.busy; clicked => { root.presets(2); } }
                    Button { text: "恢复内置默认规则"; enabled: !root.busy; clicked => { root.presets(3); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
            }
            if root.screen == 3: VerticalLayout { spacing: 14px;
                Surface {
                    VerticalLayout { padding: 18px; spacing: 12px;
                        HorizontalLayout { spacing: 14px; cross-axis-alignment: center;
                            LogoBadge { width: 52px; height: 52px; border-radius: 16px; }
                            VerticalLayout { spacing: 4px;
                                Text { text: "JchTools 0.1.0"; color: Design.text; font-size: 22px; font-weight: 700; }
                                Muted { text: "Windows 优先的本地工具箱 · 功能持续增加"; }
                            }
                        }
                        Rectangle { height: 1px; background: Design.line-soft; }
                        Muted { text: "Rust + Slint · 独立整理引擎 · SQLite 磁盘索引 · 随包携带完整 7-Zip\n当前只有目录整理工具；以后通过工具注册表添加真实工具和页面。\n运行时不联网，不上传文件，不自动提权，不执行目录中的程序。\n启动低于一秒是目标，不是未经实测的承诺。"; }
                    }
                }
                AboutSlint { }
                Muted { text: "本项目原创代码：MIT。Slint 使用其桌面 Royalty-free 许可并保留本署名组件。\n7-Zip：LGPL / BSD / unRAR 限制；随发布包提供许可证及对应源码。\n完整验证状态见包内 docs/VALIDATION.md。"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
    }
    Rectangle {
        x: parent.width - root.caption-area; y: 0; width: root.caption-area; height: 32px;
        background: transparent;
        HorizontalLayout { spacing: 0px;
            CaptionButton { kind: 0; activated => { root.minimized = true; } }
            CaptionButton { kind: 1; maximized: root.maximized; activated => { root.maximized = !root.maximized; } }
            CaptionButton { kind: 2; activated => { root.close(); } }
        }
    }
    if root.confirm-kind != 0: Rectangle {
        background: #0f172a66;
        TouchArea { }
        Surface { width: 620px; height: 335px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Palette.background;
            VerticalLayout { padding: 24px; spacing: 14px;
                Label { text: root.confirm-kind == 3 ? "停止任务并关闭" : "确认文件处理范围"; font-size: 22px; font-weight: 700; }
                Rectangle { width: 48px; height: 3px; border-radius: 2px; background: Design.bar; }
                TextEdit { text: root.confirm-text; read-only: true; vertical-stretch: 1; }
                CheckBox { text: "我已确认目录、规则及可能的永久删除行为"; checked <=> root.acknowledge; }
                HorizontalLayout { spacing: 10px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "返回检查"; clicked => { root.confirm-kind = 0; root.acknowledge = false; } }
                    Button { text: "确认"; primary: true; enabled: root.acknowledge;
                        clicked => { root.confirmed(root.confirm-kind); root.confirm-kind = 0; root.acknowledge = false; } }
                }
            }
        }
    }
    if root.conflict-visible: Rectangle {
        background: #0f172a66;
        TouchArea { }
        Surface { width: 700px; height: 360px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Palette.background;
            VerticalLayout { padding: 24px; spacing: 13px;
                Label { text: "解压遇到同名文件"; font-size: 22px; font-weight: 700; }
                Rectangle { width: 48px; height: 3px; border-radius: 2px; background: Design.bar; }
                TextEdit { text: root.conflict-text; read-only: true; vertical-stretch: 1; }
                ComboBox { model: ["覆盖旧文件", "跳过新文件", "保留最新", "保留较大", "两个都保留"];
                    current-index <=> root.conflict-choice; }
                CheckBox { text: "应用于本次任务后续解压冲突"; checked <=> root.conflict-all; }
                HorizontalLayout { spacing: 10px;
                    Button { text: "取消整个任务"; clicked => { root.cancel-task(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "应用选择"; primary: true; clicked => { root.answer-conflict(root.conflict-choice,root.conflict-all); } }
                }
            }
        }
    }
}
