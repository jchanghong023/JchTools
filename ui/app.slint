import { Button, CheckBox, ComboBox, LineEdit, ListView, TextEdit, Spinner, AboutSlint, Palette } from "std-widgets.slint";

export struct RuleRow { key: string, title: string, hint: string, kind: int, checked: bool, index: int, options: [string], value: string }
export struct PlanRow { id: string, selected: bool, kind: string, source: string, target: string, reason: string, state: string }
export struct ToolRow { id: string, name: string, summary: string }
// 界面配色：所有颜色都是不透明色，浅色/深色主题由 Design.dark 决定（写入方见 AppWindow）。
global Design {
    in property <bool> dark: false;
    in property <color> accent: #4f46e5;
    in property <color> accent-2: #0ea5e9;
    in property <color> accent-ink: dark ? #c7d2fe : #3730a3;
    in property <color> danger: #dc2626;
    in property <color> danger-ink: dark ? #fca5a5 : #b91c1c;
    in property <color> warning: #f59e0b;
    in property <color> warning-ink: dark ? #fcd34d : #b45309;
    in property <color> on-accent: #ffffff;
    in property <color> base: dark ? #1b1f2a : #ffffff;
    in property <color> ink: dark ? #eef1f8 : #16192a;
    in property <color> page-top: dark ? #232a3d : #eef0fd;
    in property <color> page-bottom: dark ? #172430 : #eaf6fc;
    in property <brush> text: ink;
    in property <brush> text-muted: ink.transparentize(0.15);
    in property <brush> page: @linear-gradient(150deg, page-top 0%, base 46%, page-bottom 100%);
    in property <brush> rail: @linear-gradient(180deg, base.mix(accent, 0.88) 0%, base.mix(accent-2, 0.94) 100%);
    in property <brush> bar: @linear-gradient(90deg, accent 0%, accent-2 100%);
    in property <color> card: base;
    in property <color> line: dark ? #ffffff24 : #10182824;
    in property <color> line-soft: dark ? #ffffff17 : #10182814;
    in property <color> hover: dark ? #ffffff1a : #10182812;
    in property <color> accent-soft: base.mix(accent, 0.84);
    in property <color> accent-softer: base.mix(accent, 0.93);
    in property <color> shadow: #0f172a26;
    in property <color> scrim: #0f172a66;
}

component Label inherits Text { color: Design.text; font-size: 14px; }
component Muted inherits Text { color: Design.text-muted; font-size: 12px; wrap: word-wrap; }

component Surface inherits Rectangle {
    background: Design.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Design.line;
    drop-shadow-color: Design.shadow;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 5px;
}

component LogoBadge inherits Rectangle {
    width: 36px; height: 36px; border-radius: 11px;
    background: Design.bar;
    drop-shadow-color: Design.accent.transparentize(0.55);
    drop-shadow-blur: 12px; drop-shadow-offset-y: 3px;
    Text { text: "J"; color: Design.on-accent; font-size: 19px; font-weight: 700;
        width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
}

// 侧栏导航的小图标：几何图形绘制，不依赖字体或图片资源
component NavGlyph inherits Rectangle {
    in property <int> kind: 0;          // 0 目录，1 关于
    in property <brush> tint: Design.text;
    width: 16px; height: 16px;
    background: transparent;

    if kind == 0: Rectangle {           // 文件夹
        x: 0; y: 4px; width: 16px; height: 11px; border-radius: 2px;
        background: transparent; border-width: 1.5px; border-color: root.tint;
    }
    if kind == 0: Rectangle { x: 1px; y: 1px; width: 7px; height: 4px; border-radius: 1px; background: root.tint; }
    if kind == 1: Rectangle {
        width: 16px; height: 16px; border-radius: 8px;
        background: transparent; border-width: 1.5px; border-color: root.tint;
    }
    if kind == 1: Rectangle { x: 7.25px; y: 4px; width: 1.5px; height: 1.5px; border-radius: 1px; background: root.tint; }
    if kind == 1: Rectangle { x: 7.25px; y: 7px; width: 1.5px; height: 5px; border-radius: 1px; background: root.tint; }
}

// 侧栏与顶部导航项：整行可点，选中项带主色底和左侧色条
component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <int> icon: -1;
    callback clicked();
    height: 40px; border-radius: 10px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    // 自绘控件默认不在 Tab 顺序里：键盘用户需要能走到导航，并在聚焦时看到焦点框。
    // FocusScope 参与 Tab 导航并接收按键；Space/回车等同于点击。
    fs := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    border-width: fs.has-focus ? 1.5px : 0px;
    border-color: Design.accent;
    background: !root.enabled ? transparent : root.active ? Design.accent-soft
        : (touch.has-hover ? Design.hover : transparent);

    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.active: Rectangle {
        x: 0; y: (root.height - 22px) / 2; width: 3px; height: 22px; border-radius: 2px;
        background: Design.accent;
    }
    if root.icon >= 0: NavGlyph {
        x: 14px; y: (root.height - 16px) / 2; kind: root.icon;
        tint: !root.enabled ? Design.text-muted : (root.active ? Design.accent-ink : Design.text-muted);
    }
    Text {
        // 父级宽度由固定行高与横向布局约束，不会形成绑定环；Slint 1.17 也不支持 100% 与 px 混合运算
        x: root.icon >= 0 ? 38px : 14px; width: root.width - (root.icon >= 0 ? 48px : 24px); height: root.height;
        text: root.text; font-size: 14px; vertical-alignment: center; overflow: elide;
        color: !root.enabled ? Design.text-muted : (root.active ? Design.accent-ink : Design.text);
        font-weight: root.active ? 600 : 400;
    }
}

// 分段式标签（规则分区、面板切换）
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px; border-radius: 10px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    fs := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    background: !root.enabled ? transparent : root.active ? Design.accent : (touch.has-hover ? Design.hover : Design.accent-softer);
    border-width: fs.has-focus ? 2px : (root.active ? 0px : 1px);
    border-color: fs.has-focus ? Design.accent-ink : Design.line-soft;

    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%; overflow: elide;
        color: !root.enabled ? Design.text-muted : (root.active ? Design.on-accent : Design.text);
        font-weight: root.active ? 600 : 500;
    }
}

// 面板切换用下划线标签（与分区的实心胶囊区分开，两者不同色不同形）
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px; border-radius: 8px;
    background: root.enabled && touch.has-hover && !root.active ? Design.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    fs := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    border-width: fs.has-focus ? 1.5px : 0px;
    border-color: Design.accent;

    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        x: 10px; width: root.width - 20px; height: root.height; text: root.text; font-size: 14px;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        color: !root.enabled ? Design.text-muted : (root.active ? Design.accent-ink : Design.text);
        font-weight: root.active ? 600 : 500;
    }
    if root.active: Rectangle {
        x: 12px; y: root.height - 3px; width: root.width - 24px; height: 2.5px; border-radius: 1.5px;
        background: Design.bar;
    }
}

// 进度条：已知总量用渐变填充，未知总量（扫描/哈希）用往返扫动的光带
component ProgressBar inherits Rectangle {
    in property <float> progress: -1;
    height: 8px; border-radius: 4px;
    background: Design.line-soft;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: root.progress >= 0 ? ("进度 " + round(root.progress * 100) + "%") : "正在处理，总量未知";
    property <bool> sweep: false;
    // bar-width 以组件自身宽度为基准：本组件宽度完全由外层布局分配（不要改成内容自适应，
    // 否则"填充宽度依赖自身宽度"会形成绑定环），因此这里读 root.width 是安全的。
    property <length> bar-width: root.progress >= 0 ? max(4px, root.width * min(root.progress, 1.0)) : root.width / 4;
    Timer { interval: 850ms; running: root.progress < 0; triggered => { root.sweep = !root.sweep; } }
    Rectangle {
        width: root.bar-width; height: parent.height; border-radius: 4px;
        background: Design.bar;
        x: root.progress >= 0 ? 0px : (root.sweep ? root.width - self.width : 0px);
        animate x { duration: 850ms; easing: ease-in-out; }
    }
}

// 自绘窗口按钮：最小化、最大化/还原、关闭
component CaptionButton inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> maximized: false;
    callback activated();
    width: 46px; height: 32px;
    accessible-role: button;
    accessible-label: kind == 0 ? "最小化" : kind == 1 ? (maximized ? "还原" : "最大化") : "关闭";
    accessible-action-default => { root.activated(); }
    fs := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.activated(); return accept; }
            return reject;
        }
    }
    border-width: fs.has-focus ? 1.5px : 0px;
    border-color: Design.accent;
    property <brush> glyph-color: touch.has-hover && kind == 2 ? Design.on-accent : Design.text;
    background: touch.has-hover ? (kind == 2 ? Design.danger : Design.hover) : transparent;

    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }

    if kind == 0: Rectangle {
        width: 10px; height: 1px; background: root.glyph-color;
        x: (root.width - 10px) / 2; y: (root.height - 1px) / 2;
    }
    if kind == 1 && !maximized: Rectangle {
        width: 10px; height: 10px; background: transparent;
        border-width: 1px; border-color: root.glyph-color;
        x: (root.width - 10px) / 2; y: (root.height - 10px) / 2;
    }
    if kind == 1 && maximized: Rectangle {
        width: 9px; height: 9px; background: transparent;
        border-width: 1px; border-color: root.glyph-color;
        x: (root.width - 9px) / 2 - 2px; y: (root.height - 9px) / 2 + 2px;
    }
    if kind == 1 && maximized: Rectangle {
        width: 9px; height: 9px; background: Design.card;
        border-width: 1px; border-color: root.glyph-color;
        x: (root.width - 9px) / 2 + 1px; y: (root.height - 9px) / 2 - 1px;
    }
    if kind == 2: Path {
        width: 10px; height: 10px;
        x: (root.width - 10px) / 2; y: (root.height - 10px) / 2;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.glyph-color; stroke-width: 1px;
    }
}

export component AppWindow inherits Window {
    title: "JchTools";
    icon: @image-url("../resources/app-icon.png");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1120px; preferred-height: 720px;
    min-width: 960px; min-height: 620px;
    background: Design.page;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    in-out property <string> directory;
    in-out property <int> screen: 0;
    in-out property <int> panel: 0;
    in-out property <int> section: 0;
    in-out property <bool> show-advanced: false;
    in-out property <bool> busy: false;
    // 代理检测独立于目录整理的 busy：检测期间关窗不得被「任务仍在处理文件」误拦。
    in-out property <bool> ready: false;
    in-out property <bool> paused: false;
    in-out property <bool> has-task: false;
    // 计划勾选是否可编辑：以任务库状态为准（ready 才可编辑）。ready 属性会因勾选保存
    // 在途短暂降下，不能直接复用它做勾选门禁（C-11：已结束任务的行不得再可点击）。
    in-out property <bool> plan-editable: false;
    in-out property <string> status: "请选择需要整理的目录";
    in-out property <string> metrics: "尚未扫描";
    in-out property <string> summary;
    in-out property <string> log-text;
    in-out property <string> error-text;
    in-out property <string> notice-text;
    in-out property <string> plan-page-label: "未生成计划";
    in-out property <bool> plan-prev-enabled: false;
    in-out property <bool> plan-next-enabled: false;
    in-out property <int> theme: 0;
    in-out property <[RuleRow]> rules;
    in-out property <[PlanRow]> plans;
    in-out property <[ToolRow]> tools;
    // 当前选中的工具 id：侧栏高亮跟随它，而不是写死“screen==0 就全亮”，
    // 以后注册第二个工具时不会互相串高亮。
    in-out property <string> active-tool-id: "directory-organizer";
    in-out property <int> tool-count: 1;
    in-out property <string> tool-search;
    in-out property <int> confirm-kind: 0;
    in-out property <string> confirm-text;
    in-out property <bool> acknowledge: false;
    in-out property <bool> conflict-visible: false;
    in-out property <string> conflict-text;
    in-out property <int> conflict-choice: 4;
    in-out property <bool> conflict-all: false;
    in-out property <bool> system-dark: false;
    in-out property <float> progress: -1;
    in-out property <string> progress-note;
    in-out property <int> archives-failed: 0;
    in-out property <int> plan-delete-count: 0;
    in-out property <int> plan-move-count: 0;
    in-out property <int> plan-link-count: 0;
    in-out property <int> plan-empty-count: 0;
    in-out property <int> plan-filter: 0;
    in-out property <int> quarantined-count: 0;
    callback choose-directory();
    callback root-edited();
    callback select-tool(string);
    callback search-tools(string);
    callback navigation(int);
    callback select-section(int);
    callback select-theme(int);
    callback toggle-advanced(bool);
    callback rule-bool(string,bool);
    callback rule-choice(string,int);
    callback rule-text(string,string);
    callback request-start();
    callback request-apply();
    callback confirmed(int);
    callback pause-task();
    callback cancel-task();
    callback plan-toggle(string,bool);
    callback plan-page(int);
    callback filter-plan(string);
    callback open-report();
    callback answer-conflict(int,bool);
    callback request-extract-start();
    callback window-drag-start(length,length);
    callback window-drag-move(length,length);
    property <length> caption-area: 138px;
    property <length> rail-width: 208px;
    property <length> page-padding: 24px;

    // 主题：0 跟随系统，1 浅色，2 深色；自绘配色与控件配色保持一致
    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Design.dark = root.theme == 2 || (root.theme == 0 && root.system-dark);
    }
    init => { root.apply-theme(); }
    changed theme => { root.apply-theme(); }
    changed system-dark => { root.apply-theme(); }

    // 背景装饰：柔和光晕铺在内容之下
    Rectangle {
        x: -140px; y: -180px; width: 620px; height: 620px;
        background: @radial-gradient(circle, Design.base.mix(Design.accent, 0.84) 0%, Design.base 72%);
    }
    Rectangle {
        x: parent.width - 460px; y: parent.height - 420px; width: 640px; height: 640px;
        background: @radial-gradient(circle, Design.base.mix(Design.accent-2, 0.86) 0%, Design.base 70%);
    }

    // 无系统标题栏：顶部条带负责拖动与窗口按钮，其余内容与普通窗口一致
    TouchArea {
        x: 0; y: 0; width: parent.width; height: 32px;
        accessible-role: button;
        accessible-label: "窗口标题栏：拖动移动窗口，双击切换最大化";
        accessible-action-default => { root.maximized = !root.maximized; }
        double-clicked => { root.maximized = !root.maximized; }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.window-drag-start(self.mouse-x, self.mouse-y); }
        }
        moved => { root.window-drag-move(self.mouse-x, self.mouse-y); }
    }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.rail-width; background: Design.rail;
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Design.line; }
            VerticalLayout {
                padding: 20px; padding-top: 40px; padding-bottom: 16px; spacing: 8px;
                HorizontalLayout { spacing: 12px; cross-axis-alignment: center;
                    LogoBadge { width: 40px; height: 40px; border-radius: 12px; }
                    VerticalLayout { spacing: 2px;
                        Text { text: "JchTools"; color: Design.text; font-size: 18px; font-weight: 700; }
                        Muted { text: "本地工具箱"; font-size: 11px; }
                    }
                }
                Rectangle { height: 10px; background: transparent; }
                if root.tool-count > 5: LineEdit {
                    text <=> root.tool-search; placeholder-text: "搜索工具";
                    edited(value) => { root.search-tools(value); }
                }
                Muted { text: "工具"; font-size: 11px; font-weight: 600; }
                for tool in root.tools: NavItem {
                    text: tool.name;
                    icon: 0;
                    active: tool.id == root.active-tool-id;
                    // 模态确认层打开时导航不可点，避免点击穿透背景控件。
                    enabled: root.confirm-kind == 0 && !root.conflict-visible;
                    clicked => { root.select-tool(tool.id); }
                }
                Rectangle { height: 12px; background: transparent; }
                NavItem { text: "关于"; icon: 1; active: root.screen == 1; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.navigation(1); } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle { height: 1px; background: Design.line-soft; }
                Muted { text: "本地处理 · 不上传文件\nWindows 优先"; font-size: 11px; }
            }
        }
        VerticalLayout {
            padding: root.page-padding; padding-top: 36px; padding-bottom: 16px; spacing: 10px;
            // 页面标题区
            HorizontalLayout { height: 32px; spacing: 12px; cross-axis-alignment: center;
                Label { text: root.screen == 0 ? "目录整理" : root.screen == 2 ? "递归解压" : "关于 JchTools";
                    font-size: 22px; font-weight: 700; }
                Rectangle { width: 3px; height: 18px; border-radius: 2px; background: Design.bar; }
                Muted { text: root.screen == 0 ? "内容去重、归类与清理（不解压）；先分析出计划，确认后才执行。"
                    : root.screen == 2 ? "递归解开压缩包；成功原包直接永久删除，失败原包集中到「解压失败」。"
                    : "Windows 优先的本地工具箱 · 功能持续增加";
                    horizontal-stretch: 1; wrap: no-wrap; overflow: elide; vertical-alignment: center; font-size: 13px; }
                if root.busy: Spinner { width: 20px; height: 20px; }
                Rectangle { width: root.caption-area; background: transparent; }
            }
            if root.error-text != "": Rectangle {
                min-height: 40px; border-radius: 12px;
                background: Design.base.mix(Design.danger, 0.90);
                border-width: 1px; border-color: Design.base.mix(Design.danger, 0.62);
                HorizontalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; spacing: 12px; cross-axis-alignment: center;
                    Rectangle { width: 4px; height: 20px; border-radius: 2px; background: Design.danger; }
                    Text { text: root.error-text; wrap: word-wrap; color: Design.danger-ink; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "关闭"; clicked => { root.error-text = ""; } }
                }
            }
            // 成功/中性提示与错误分开：复制完成这类消息不再用红色错误样式。
            if root.notice-text != "": Rectangle {
                min-height: 40px; border-radius: 12px;
                background: Design.base.mix(Design.accent-2, 0.90);
                border-width: 1px; border-color: Design.base.mix(Design.accent-2, 0.62);
                HorizontalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; spacing: 12px; cross-axis-alignment: center;
                    Rectangle { width: 4px; height: 20px; border-radius: 2px; background: Design.accent-2; }
                    Text { text: root.notice-text; wrap: word-wrap; color: Design.accent-ink; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "关闭"; clicked => { root.notice-text = ""; } }
                }
            }
            if root.screen == 0: VerticalLayout {
                spacing: 8px;
                // 目录选择：独立卡片，作为主输入
                Surface {
                    min-height: 48px;
                    HorizontalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 12px; spacing: 10px; cross-axis-alignment: center;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 8px;
                            background: Design.accent-softer;
                            NavGlyph {
                                x: 6px; y: 6px; kind: 0;
                                tint: Design.accent-ink;
                            }
                        }
                        LineEdit { text <=> root.directory; placeholder-text: "选择或输入要整理的目录，例如 D:\\Downloads";
                            enabled: !root.busy && root.confirm-kind == 0; horizontal-stretch: 1; edited(value) => { root.root-edited(); } }
                        Button { text: "选择目录…"; enabled: !root.busy && root.confirm-kind == 0; clicked => { root.choose-directory(); } }
                    }
                }
                // 面板页签 + 任务操作
                HorizontalLayout { height: 32px; spacing: 2px;
                    Tab { text: "处理规则"; active: root.panel == 0; width: 104px; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.panel = 0; } }
                    Tab { text: "整理计划"; active: root.panel == 1; width: 104px; enabled: root.has-task && root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.panel = 1; } }
                    Tab { text: "进度与日志"; active: root.panel == 2; width: 118px; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.panel = 2; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if root.has-task: Button { text: "打开任务目录"; enabled: !root.busy && root.confirm-kind == 0; clicked => { root.open-report(); } }
                }
                // 规则分区胶囊
                if root.panel == 0: Rectangle {
                    height: 32px; border-radius: 12px;
                    background: Design.base.mix(Design.accent, 0.95);
                    border-width: 1px; border-color: Design.line-soft;
                    HorizontalLayout { padding: 3px; spacing: 4px;
                        for label[index] in ["去重", "归类", "清理", "安全与性能"]: Pill {
                            text: label; active: root.section == index; enabled: !root.busy && root.confirm-kind == 0; horizontal-stretch: 1;
                            height: 24px;
                            clicked => { root.select-section(index); }
                        }
                        // 高级选项开关：只控制是否显示专家调优项，不改变任何规则值。
                        Pill { text: root.show-advanced ? "隐藏高级选项" : "显示高级选项"; active: root.show-advanced;
                            width: 132px; height: 24px; enabled: !root.busy && root.confirm-kind == 0;
                            clicked => { root.toggle-advanced(!root.show-advanced); } }
                    }
                }
                if root.panel == 0: Surface { vertical-stretch: 1;
                    // 行高 44px：U-05 要求默认 1120×720 下「处理规则」同屏可见 9 行；
                    // 说明文字单行省略，不换行撑高。
                    ListView { for row in root.rules: Rectangle {
                        height: 44px;
                        HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 16px; cross-axis-alignment: center;
                            VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                Label { text: row.title; font-weight: 600; font-size: 13px; overflow: elide; }
                                Muted { text: row.hint; wrap: no-wrap; overflow: elide; font-size: 11px; }
                            }
                            // 规则控件直接写 config，模态确认期间必须与目录输入同口径禁用：
                            // 否则键盘可穿透确认框改删除策略，确认文案与实际执行不符。
                            if row.kind == 0: CheckBox { checked: row.checked; enabled: !root.busy && root.confirm-kind == 0;
                                text: "启用"; accessible-label: row.title;
                                toggled => { root.rule-bool(row.key,self.checked); } }
                            if row.kind == 1: ComboBox { width: 220px; model: row.options; current-index: row.index;
                                enabled: !root.busy && root.confirm-kind == 0; accessible-label: row.title;
                                selected(value) => { root.rule-choice(row.key,self.current-index); } }
                            if row.kind == 2: LineEdit { width: 160px; text: row.value; enabled: !root.busy && root.confirm-kind == 0;
                                horizontal-alignment: right; accessible-label: row.title;
                                // Slint 1.17 的 UIA 桥接会把纯数字的 accessible-value 当成数值属性上报，
                                // 读屏读到的值只有 0；这里把当前值写进描述，读屏聚焦时报“当前值 N”。
                                accessible-description: "当前值 " + row.value;
                                edited(value) => { root.rule-text(row.key,value); } }
                        }
                        Rectangle { y: parent.height - 1px; x: 16px; height: 1px; width: parent.width - 32px;
                            background: Design.line-soft; }
                    }}
                }
                if root.panel == 1: VerticalLayout { spacing: 10px;
                    Surface { min-height: 72px;
                        VerticalLayout { padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; spacing: 4px;
                            Muted { text: "任务摘要"; font-size: 11px; font-weight: 600; }
                            TextEdit { text: root.summary; read-only: true; }
                        }
                    }
                    // 计划类型筛选
                    HorizontalLayout { height: 30px; spacing: 4px;
                        Pill { text: "全部"; active: root.plan-filter == 0; width: 64px; enabled: !root.busy && root.confirm-kind == 0;
                            clicked => { root.plan-filter = 0; root.filter-plan(""); } }
                        Pill { text: "删除 " + root.plan-delete-count; active: root.plan-filter == 1; width: 88px; enabled: !root.busy && root.plan-delete-count > 0 && root.confirm-kind == 0;
                            clicked => { root.plan-filter = 1; root.filter-plan("delete"); } }
                        Pill { text: "移动 " + root.plan-move-count; active: root.plan-filter == 2; width: 88px; enabled: !root.busy && root.plan-move-count > 0 && root.confirm-kind == 0;
                            clicked => { root.plan-filter = 2; root.filter-plan("move"); } }
                        Pill { text: "硬链接 " + root.plan-link-count; active: root.plan-filter == 3; width: 96px; enabled: !root.busy && root.plan-link-count > 0 && root.confirm-kind == 0;
                            clicked => { root.plan-filter = 3; root.filter-plan("hardlink"); } }
                        Pill { text: "空目录 " + root.plan-empty-count; active: root.plan-filter == 4; width: 96px; enabled: !root.busy && root.plan-empty-count > 0 && root.confirm-kind == 0;
                            clicked => { root.plan-filter = 4; root.filter-plan("empty_directory"); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Surface { vertical-stretch: 1;
                        ListView { for item in root.plans: Rectangle { height: 78px;
                            HorizontalLayout { padding-top: 10px; padding-bottom: 10px; padding-left: 14px; padding-right: 14px; spacing: 12px; cross-axis-alignment: center;
                                // 勾选保存中 ready 短暂为 false：此时仍允许继续改其他勾选，
                                // 否则整表被锁且主按钮文案被误切。
                                CheckBox { checked: item.selected; enabled: !root.busy && root.confirm-kind == 0 && item.state == "待执行" && root.plan-editable;
                                    accessible-label: item.kind + " " + item.source;
                                    toggled => { root.plan-toggle(item.id,self.checked); } }
                                VerticalLayout { horizontal-stretch: 1; spacing: 3px;
                                    Label { text: item.kind + "  ·  " + item.state; font-weight: 600; color: Design.accent-ink; font-size: 13px; }
                                    Label { text: item.source; overflow: elide; }
                                    Muted { text: item.target == "" ? item.reason : "→ " + item.target + " · " + item.reason; overflow: elide; }
                                }
                            }
                            Rectangle { y: parent.height - 1px; x: 14px; height: 1px; width: parent.width - 28px; background: Design.line-soft; }
                        }}
                    }
                    HorizontalLayout { height: 32px; spacing: 8px; cross-axis-alignment: center;
                        Button { text: "上一页"; enabled: !root.busy && root.plan-prev-enabled && root.confirm-kind == 0; clicked => { root.plan-page(-1); } }
                        Muted { text: root.plan-page-label; wrap: no-wrap; horizontal-alignment: center; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: "下一页"; enabled: !root.busy && root.plan-next-enabled && root.confirm-kind == 0; clicked => { root.plan-page(1); } }
                    }
                }
                if root.panel == 2: Surface { vertical-stretch: 1;
                    VerticalLayout { padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; spacing: 8px;
                        Muted { text: "最新的消息显示在最上面；界面只保留最近 300 条。"; }
                        TextEdit { text: root.log-text; read-only: true; font-family: "Consolas"; vertical-stretch: 1; }
                    }
                }
                // 底部状态与主操作
                Surface {
                    min-height: 56px;
                    background: @linear-gradient(120deg, Design.base.mix(Design.accent, 0.88) 0%, Design.base.mix(Design.accent-2, 0.92) 100%);
                    border-color: Design.base.mix(Design.accent, 0.68);
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    VerticalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 16px; padding-right: 14px; spacing: 8px;
                        HorizontalLayout { spacing: 12px; cross-axis-alignment: center;
                            VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                    Rectangle { width: 44px; height: 20px; border-radius: 6px;
                                        background: root.busy ? Design.accent : Design.accent-soft;
                                        Text { text: root.busy ? "进行中" : "状态"; font-size: 11px; font-weight: 600;
                                            color: root.busy ? Design.on-accent : Design.accent-ink;
                                            width: parent.width; height: parent.height;
                                            horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Label { text: root.status; overflow: elide; font-weight: 600; horizontal-stretch: 1; font-size: 14px; }
                                }
                                Muted { text: root.metrics; wrap: no-wrap; overflow: elide; font-size: 12px; }
                            }
                            if root.busy: Text { text: root.progress-note; wrap: no-wrap; overflow: elide; color: Design.accent-ink; font-weight: 600; }
                            if root.busy && root.progress >= 0: Text {
                                text: round(root.progress * 100) + "%"; font-size: 22px; font-weight: 700; color: Design.accent-ink;
                            }
                            // 模态（如 kind=3 停止并关闭）与解压冲突框打开期间都禁用：键盘
                            // 不得穿透遮罩直接暂停/取消任务，必须先处理最上层对话框。
                            if root.busy: Button { text: root.paused ? "继续" : "暂停"; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.pause-task(); } }
                            if root.busy: Button { text: "取消任务"; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.cancel-task(); } }
                            if !root.busy && root.ready: Button { text: "确认并执行整理"; primary: true; enabled: root.confirm-kind == 0; clicked => { root.request-apply(); } }
                            if !root.busy && !root.ready: Button { text: "开始分析"; primary: true; enabled: root.directory != "" && root.confirm-kind == 0;
                                clicked => { root.request-start(); } }
                        }
                        if root.busy: ProgressBar { progress: root.progress; }
                    }
                }
            }
            if root.screen == 2: VerticalLayout {
                spacing: 8px;
                // 目录选择：独立卡片，作为主输入
                Surface {
                    min-height: 48px;
                    HorizontalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 12px; spacing: 10px; cross-axis-alignment: center;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 8px;
                            background: Design.accent-softer;
                            NavGlyph {
                                x: 6px; y: 6px; kind: 0;
                                tint: Design.accent-ink;
                            }
                        }
                        LineEdit { text <=> root.directory; placeholder-text: "选择或输入要解压的目录，例如 D:\\Downloads";
                            enabled: !root.busy && root.confirm-kind == 0; horizontal-stretch: 1; edited(value) => { root.root-edited(); } }
                        Button { text: "选择目录…"; enabled: !root.busy && root.confirm-kind == 0; clicked => { root.choose-directory(); } }
                    }
                }
                // 一段式（X-02）：只有规则与日志两个面板，没有计划审核环节
                HorizontalLayout { height: 32px; spacing: 2px;
                    Tab { text: "处理规则"; active: root.panel == 0; width: 104px; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.panel = 0; } }
                    Tab { text: "进度与日志"; active: root.panel == 1; width: 118px; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.panel = 1; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                // 规则分区胶囊（递归解压只有解压与安全两分区）
                if root.panel == 0: Rectangle {
                    height: 32px; border-radius: 12px;
                    background: Design.base.mix(Design.accent, 0.95);
                    border-width: 1px; border-color: Design.line-soft;
                    HorizontalLayout { padding: 3px; spacing: 4px;
                        for label[index] in ["解压", "安全与性能"]: Pill {
                            text: label; active: root.section == index; enabled: !root.busy && root.confirm-kind == 0; horizontal-stretch: 1;
                            height: 24px;
                            clicked => { root.select-section(index); }
                        }
                        // 高级选项开关：只控制是否显示专家调优项，不改变任何规则值。
                        Pill { text: root.show-advanced ? "隐藏高级选项" : "显示高级选项"; active: root.show-advanced;
                            width: 132px; height: 24px; enabled: !root.busy && root.confirm-kind == 0;
                            clicked => { root.toggle-advanced(!root.show-advanced); } }
                    }
                }
                if root.panel == 0: Surface { vertical-stretch: 1;
                    // 行高 44px：与目录整理同口径（U-05 的可见行数约束）。
                    ListView { for row in root.rules: Rectangle {
                        height: 44px;
                        HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 16px; cross-axis-alignment: center;
                            VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                Label { text: row.title; font-weight: 600; font-size: 13px; overflow: elide; }
                                Muted { text: row.hint; wrap: no-wrap; overflow: elide; font-size: 11px; }
                            }
                            if row.kind == 0: CheckBox { checked: row.checked; enabled: !root.busy && root.confirm-kind == 0;
                                text: "启用"; accessible-label: row.title;
                                toggled => { root.rule-bool(row.key,self.checked); } }
                            if row.kind == 1: ComboBox { width: 220px; model: row.options; current-index: row.index;
                                enabled: !root.busy && root.confirm-kind == 0; accessible-label: row.title;
                                selected(value) => { root.rule-choice(row.key,self.current-index); } }
                            if row.kind == 2: LineEdit { width: 160px; text: row.value; enabled: !root.busy && root.confirm-kind == 0;
                                horizontal-alignment: right; accessible-label: row.title;
                                accessible-description: "当前值 " + row.value;
                                edited(value) => { root.rule-text(row.key,value); } }
                        }
                        Rectangle { y: parent.height - 1px; x: 16px; height: 1px; width: parent.width - 32px;
                            background: Design.line-soft; }
                    }}
                }
                if root.panel == 1: VerticalLayout { spacing: 10px;
                    if root.quarantined-count > 0: Rectangle {
                        min-height: 36px; border-radius: 10px;
                        background: Design.base.mix(Design.warning, 0.90);
                        border-width: 1px; border-color: Design.base.mix(Design.warning, 0.65);
                        HorizontalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 12px; padding-right: 12px; spacing: 10px; cross-axis-alignment: center;
                            Rectangle { width: 4px; height: 18px; border-radius: 2px; background: Design.warning; }
                            Text { text: "有 " + root.quarantined-count + " 个压缩包未完全解开，已移入「解压失败」子目录等待人工处理；详情见下方日志。";
                                color: Design.text; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; font-size: 12px; }
                        }
                    }
                    Surface { vertical-stretch: 1;
                        VerticalLayout { padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; spacing: 8px;
                            Muted { text: "最新的消息显示在最上面；界面只保留最近 300 条。"; }
                            TextEdit { text: root.log-text; read-only: true; font-family: "Consolas"; vertical-stretch: 1; }
                        }
                    }
                }
                // 底部状态与主操作
                Surface {
                    min-height: 56px;
                    background: @linear-gradient(120deg, Design.base.mix(Design.accent, 0.88) 0%, Design.base.mix(Design.accent-2, 0.92) 100%);
                    border-color: Design.base.mix(Design.accent, 0.68);
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    VerticalLayout { padding-top: 8px; padding-bottom: 8px; padding-left: 16px; padding-right: 14px; spacing: 8px;
                        HorizontalLayout { spacing: 12px; cross-axis-alignment: center;
                            VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                    Rectangle { width: 44px; height: 20px; border-radius: 6px;
                                        background: root.busy ? Design.accent : Design.accent-soft;
                                        Text { text: root.busy ? "进行中" : "状态"; font-size: 11px; font-weight: 600;
                                            color: root.busy ? Design.on-accent : Design.accent-ink;
                                            width: parent.width; height: parent.height;
                                            horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Label { text: root.status; overflow: elide; font-weight: 600; horizontal-stretch: 1; font-size: 14px; }
                                }
                                Muted { text: root.metrics; wrap: no-wrap; overflow: elide; font-size: 12px; }
                            }
                            if root.busy: Text { text: root.progress-note; wrap: no-wrap; overflow: elide; color: Design.accent-ink; font-weight: 600; }
                            if root.busy: Button { text: root.paused ? "继续" : "暂停"; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.pause-task(); } }
                            if root.busy: Button { text: "取消任务"; enabled: root.confirm-kind == 0 && !root.conflict-visible; clicked => { root.cancel-task(); } }
                            if !root.busy: Button { text: "开始解压"; primary: true; enabled: root.directory != "" && root.confirm-kind == 0;
                                clicked => { root.request-extract-start(); } }
                        }
                        if root.busy: ProgressBar { progress: root.progress; }
                    }
                }
            }
            if root.screen == 1: VerticalLayout { spacing: 14px;
                Surface {
                    VerticalLayout { padding: 22px; spacing: 14px;
                        HorizontalLayout { spacing: 16px; cross-axis-alignment: center;
                            LogoBadge { width: 56px; height: 56px; border-radius: 16px; }
                            VerticalLayout { spacing: 4px;
                                Text { text: "JchTools 0.1.0"; color: Design.text; font-size: 22px; font-weight: 700; }
                                Muted { text: "Windows 优先的本地工具箱 · 功能持续增加"; }
                            }
                        }
                        Rectangle { height: 1px; background: Design.line-soft; }
                        Muted { text: "Rust + Slint · 独立整理引擎 · SQLite 磁盘索引 · 随包携带完整 7-Zip\n已注册工具：递归解压、目录整理；以后通过工具注册表添加真实工具和页面。\n软件完全离线：不发起任何网络请求、不上传文件、不自动提权、不执行目录中的程序。\n启动低于一秒是目标，不是未经实测的承诺。"; }
                    }
                }
                // 主题是应用级设置，放在关于页而不是目录整理的规则分区。
                Surface {
                    VerticalLayout { padding: 18px; spacing: 10px;
                        Label { text: "外观"; font-weight: 600; font-size: 14px; }
                        HorizontalLayout { spacing: 6px;
                            for item[index] in ["跟随系统", "浅色", "深色"]: Pill {
                                text: item; active: root.theme == index; width: 104px; height: 32px;
                                enabled: root.confirm-kind == 0 && !root.conflict-visible;
                                clicked => { root.select-theme(index); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Muted { text: "立即生效；不影响整理规则，也不使已生成的计划失效。"; }
                    }
                }
                AboutSlint { }
                Muted { text: "本项目原创代码：MIT。Slint 使用其桌面 Royalty-free 许可并保留本署名组件。\n7-Zip：LGPL / BSD / unRAR 限制；随发布包提供许可证及对应源码。"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
    }
    Rectangle {
        x: parent.width - root.caption-area; y: 0; width: root.caption-area; height: 32px;
        background: transparent;
        HorizontalLayout { spacing: 0px;
            CaptionButton { kind: 0; activated => { root.minimized = true; } }
            CaptionButton { kind: 1; maximized: root.maximized; activated => { root.maximized = !root.maximized; } }
            CaptionButton { kind: 2; activated => { root.close(); } }
        }
    }
    if root.conflict-visible: Rectangle {
        background: Design.scrim;
        TouchArea { }
        Surface { width: 700px; height: 360px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Design.card;
            VerticalLayout { padding: 24px; spacing: 13px;
                Label { text: "解压遇到同名文件"; font-size: 22px; font-weight: 700; }
                Rectangle { width: 48px; height: 3px; border-radius: 2px; background: Design.bar; }
                TextEdit { text: root.conflict-text; read-only: true; vertical-stretch: 1; }
                ComboBox { model: ["覆盖旧文件", "跳过新文件", "保留修改时间更新的", "保留较大的", "两个都保留并重命名"]; enabled: root.confirm-kind == 0;
                    accessible-label: "解压冲突处理方式";
                    current-index <=> root.conflict-choice; }
                CheckBox { text: "应用于本次任务后续解压冲突"; checked <=> root.conflict-all; enabled: root.confirm-kind == 0; }
                HorizontalLayout { spacing: 10px;
                    Button { text: "取消整个任务"; enabled: root.confirm-kind == 0; clicked => { root.cancel-task(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "应用选择"; primary: true; enabled: root.confirm-kind == 0; clicked => { root.answer-conflict(root.conflict-choice,root.conflict-all); } }
                }
            }
        }
    }
    // 确认层画在冲突层之后：任务运行中收到关闭请求时（confirm-kind=3）它必须盖在冲突对话框之上，
    // 否则用户只能看到一张被压在下面的确认框。
    if root.confirm-kind != 0: Rectangle {
        background: Design.scrim;
        TouchArea { }
        Surface { width: 620px; height: 335px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Design.card;
            VerticalLayout { padding: 24px; spacing: 14px;
                Label { text: root.confirm-kind == 3 ? "停止任务并关闭" : "确认文件处理范围"; font-size: 22px; font-weight: 700; }
                Rectangle { width: 48px; height: 3px; border-radius: 2px; background: Design.bar; }
                TextEdit { text: root.confirm-text; read-only: true; vertical-stretch: 1; }
                // 关闭确认不处理目录文件，不需要“永久删除”那一句勾选。
                if root.confirm-kind != 3: CheckBox { text: "我已确认目录、规则及可能的永久删除行为"; checked <=> root.acknowledge; }
                HorizontalLayout { spacing: 10px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "返回检查"; clicked => { root.confirm-kind = 0; root.acknowledge = false; } }
                    Button { text: root.confirm-kind == 3 ? "停止并关闭" : "确认"; primary: true;
                        enabled: root.confirm-kind == 3 || root.acknowledge;
                        clicked => { root.confirmed(root.confirm-kind); root.confirm-kind = 0; root.acknowledge = false; } }
                }
            }
        }
    }
}
